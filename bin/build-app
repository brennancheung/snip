#!/bin/sh
# Builds Snip.app into build/ and signs it.
# Screen Recording permission is tied to the signature: with ad-hoc signing macOS asks again
# after every rebuild. So it signs with SNIP_SIGN_IDENTITY if set, else with "Snip Local Signing"
# (a self-signed certificate in the login keychain, made by bin/make-signing-cert) if
# `security find-identity` lists it, else ad hoc.
set -eu
cd "$(dirname "$0")/.."

swift build -c release --product Snip
bin_dir=$(swift build -c release --show-bin-path)

app=build/Snip.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin_dir/Snip" "$app/Contents/MacOS/Snip"
cp Resources/Info.plist "$app/Contents/Info.plist"

local_identity="Snip Local Signing"
if [ -n "${SNIP_SIGN_IDENTITY:-}" ]; then
    identity=$SNIP_SIGN_IDENTITY
elif security find-identity -p codesigning 2>/dev/null | grep -qF "\"$local_identity\""; then
    identity=$local_identity
else
    identity=-
fi
if [ "$identity" = "-" ]; then
    echo "Signing ad hoc (macOS will ask for Screen Recording permission again)" >&2
else
    echo "Signing with \"$identity\"" >&2
fi

codesign --force --sign "$identity" "$app"
echo "$(pwd)/$app"
